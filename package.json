{
  "name": "super-table",
  "version": "1.0.3",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Editable Obsidian data tables with typed fields, date formats, grouping, and multiple named views over shared records.",
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --outfile=main.js --external:obsidian --external:@codemirror/state --external:@codemirror/view --format=cjs --platform=browser --target=es2020 --watch",
    "build": "esbuild src/main.ts --bundle --outfile=main.js --external:obsidian --external:@codemirror/state --external:@codemirror/view --format=cjs --platform=browser --target=es2020",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "scan": "node scripts/scan.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "26.1.0",
    "obsidian": "^1.8.7",
    "postcss": "8.5.31",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "moment": "2.31.0"
  }
}
